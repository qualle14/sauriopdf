{
  "name": "@sauriopdf/core",
  "version": "0.2.1",
  "exports": {
    ".": "./mod.ts",
    "./slim": "./mod.slim.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write main_test.ts",
    "test:watch": "deno test --allow-read --allow-write --watch main_test.ts",
    "check": "deno check mod.ts",
    "demo": "deno run --allow-read --allow-write demo.ts",
    "build:wasm": "cd rust-core && cargo build --target wasm32-unknown-unknown --release && wasm-bindgen target/wasm32-unknown-unknown/release/sauriopdf_core.wasm --out-dir ../wasm --target web",
    "build:wasm:slim": "cd rust-core && cargo build --target wasm32-unknown-unknown --release --no-default-features --features console_error_panic_hook && wasm-bindgen target/wasm32-unknown-unknown/release/sauriopdf_core.wasm --out-dir ../wasm-slim --target web",
    "lint": "deno lint --ignore=rust-core,node_modules",
    "fmt": "deno fmt --ignore=rust-core,node_modules"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["rust-core/", "node_modules/", "wasm/", "wasm-slim/", ".idea/"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 88,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["rust-core/", "node_modules/", "wasm/", "wasm-slim/", ".idea/"]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  },
  "publish": {
    "include": [
      "mod.ts",
      "mod.slim.ts",
      "src/",
      "lib/",
      "wasm/",
      "wasm-slim/",
      "fonts/",
      "README.md",
      "llms.txt",
      "LICENSE"
    ]
  }
}
